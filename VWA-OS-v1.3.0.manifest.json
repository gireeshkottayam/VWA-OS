    "kotlin-agent.md",
    "csharp-agent.md",
    "c-agent.md",
    "cpp-agent.md",
    "rust-agent.md",
    "go-agent.md",
    "ruby-agent.md",
    "swift-agent.md",
    "dart-agent.md",
    "sql-agent.md",
    "bash-agent.md",
    "powershell-agent.md"
