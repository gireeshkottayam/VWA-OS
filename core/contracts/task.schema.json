{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VWA Task Contract",
  "type": "object",
  "required": [
    "goal",
    "acceptance_criteria"
  ],
  "properties": {
    "goal": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}