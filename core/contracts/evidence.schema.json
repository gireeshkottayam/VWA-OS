{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "check",
    "status"
  ],
  "properties": {
    "check": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "not-run"
      ]
    },
    "artifact": {
      "type": "string"
    }
  }
}
